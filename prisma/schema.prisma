// Prisma schema for the quiz-app-web project.
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum QuizStatus {
  PUBLIC
  PRIVATE
}

enum QuestionType {
  QCM_SIMPLE
  QCM_MULTIPLE
  DATE
  CALCUL
}

enum BadgeType {
  EXPLORATEUR
  QCM
  REPONSE_LIBRE
}

enum AttemptMode {
  ENTRAINEMENT
  QCM
  REPONSE_LIBRE
}

enum DuelStatus {
  PENDING
  ACTIVE
  DECLINED
  CANCELLED
  FINISHED
  ABANDONED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  quizzes  Quiz[]
  badges   Badge[]
  attempts Attempt[]
}

model Quiz {
  id                       String     @id @default(cuid())
  title                    String
  description              String?
  imageUrl                 String?
  status                   QuizStatus @default(PRIVATE)
  // Token used to build the share link / QR code / access key. Null means
  // sharing is disabled. Regenerating it revokes whatever link/QR/key was
  // handed out before.
  // Per-quiz UI color overrides: { primary?, success?, error?, warning?,
  // level2Primary?, level2Card? }, hex strings. Absent keys fall back to the site-wide defaults.
  themeColors              Json?
  // Lets the creator turn off the "Reponse libre parfaite" badge for this
  // quiz (e.g. when it doesn't use AI-graded free-text questions). Hidden
  // from the badge row and excluded from the points-system maximum when off.
  reponseLibreBadgeEnabled Boolean    @default(true)
  createdAt                DateTime   @default(now())
  updatedAt                DateTime   @updatedAt

  creatorId  String
  creator    User          @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  themes     QuizTheme[]
  guestLinks GuestAccess[]
  duels      Duel[]
}

model Theme {
  id          String   @id @default(cuid())
  title       String
  description String?
  createdAt   DateTime @default(now())

  quizzes   QuizTheme[]
  questions Question[]
  badges    Badge[]
}

// Join table for the many-to-many Quiz <-> Theme relation.
model QuizTheme {
  quizId        String
  themeId       String
  // Display position of this chapter within the quiz, set by the creator via
  // drag-and-drop. No @@unique constraint: a reorder updates many rows in one
  // transaction and could transiently collide with a uniqueness check.
  // Consistency is enforced at the application layer instead.
  order         Int
  // Lets the creator hide a chapter from this quiz without deleting it (or its
  // questions/attempts): disabled chapters are left out of the chapter
  // selection, the question sets, progress pages and points totals.
  enabled       Boolean @default(true)
  // Set on a "niveau 2" chapter: the themeId of the chapter of this same quiz
  // it extends. Level-2 chapters are left out of the main carousel and shown
  // under their parent instead, once every badge of the parent is earned.
  parentThemeId String?

  quiz  Quiz  @relation(fields: [quizId], references: [id], onDelete: Cascade)
  theme Theme @relation(fields: [themeId], references: [id], onDelete: Cascade)

  @@id([quizId, themeId])
  @@index([quizId, order])
}

model Question {
  id        String       @id @default(cuid())
  themeId   String
  type      QuestionType
  content   Json
  // Sub-topic within the theme/chapter, used to let training sessions be
  // scoped to a subset of questions. Optional — not every question has one.
  section   String?
  createdAt DateTime     @default(now())

  theme    Theme     @relation(fields: [themeId], references: [id], onDelete: Cascade)
  attempts Attempt[]

  @@index([themeId])
}

// userId/guestAccessId: exactly one is set, matching how Attempt attributes
// answers. Uniqueness within each identity (one badge per type per theme) is
// enforced by two partial indexes in the migration SQL — Prisma's schema
// language has no way to express a "WHERE column IS NOT NULL" unique index,
// and a single @@unique([userId, guestAccessId, themeId, type]) wouldn't
// work here since Postgres never treats two NULLs as equal.
model Badge {
  id            String    @id @default(cuid())
  userId        String?
  guestAccessId String?
  themeId       String
  type          BadgeType
  earnedAt      DateTime  @default(now())

  user        User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  guestAccess GuestAccess? @relation(fields: [guestAccessId], references: [id], onDelete: Cascade)
  theme       Theme        @relation(fields: [themeId], references: [id], onDelete: Cascade)

  @@index([guestAccessId])
}

// One named share link for a quiz. A quiz can have several — one per person
// it's been shared with — each with its own token, progress and cookie.
// activeToken is overwritten every time the link is opened, which is what
// makes a previously-issued cookie for THIS link stale on other devices;
// guestAccessId itself (and its attempts/badges) persists across reopens.
model GuestAccess {
  id          String   @id @default(cuid())
  quizId      String
  token       String   @unique
  guestName   String?
  activeToken String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  quiz          Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  attempts      Attempt[]
  badges        Badge[]
  duelsSent     Duel[]       @relation("DuelChallenger")
  duelsReceived Duel[]       @relation("DuelOpponent")
  duelAnswers   DuelAnswer[]

  @@index([quizId])
}

model Attempt {
  id            String      @id @default(cuid())
  userId        String?
  guestAccessId String?
  questionId    String
  mode          AttemptMode
  // Groups the attempts of one full QCM / réponse libre session together, so
  // the "100% on a single session" badge rule can be checked. Null for
  // untimed ENTRAINEMENT-mode attempts, which aren't part of a session.
  sessionId     String?
  answerGiven   Json
  isCorrect     Boolean
  // Optional free-text message left by the person answering, shown to the
  // quiz creator alongside the question it was written under.
  comment       String?
  createdAt     DateTime    @default(now())

  user        User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  guestAccess GuestAccess? @relation(fields: [guestAccessId], references: [id], onDelete: Cascade)
  question    Question     @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([guestAccessId])
  @@index([questionId])
  @@index([sessionId])
}

// A best-of-N quiz duel between two guest links of the same quiz. The
// challenger picks bestOf (1, 3 or 5) when sending it; it stays PENDING until
// the opponent accepts (ACTIVE) or declines, and PENDING duels older than
// DUEL_INVITE_TTL_MS (lib/duel.ts) are treated as CANCELLED. Every round is
// played to the end — bestOf is the number of rounds, not a "first to" target.
model Duel {
  id               String     @id @default(cuid())
  quizId           String
  challengerId     String
  opponentId       String
  bestOf           Int
  status           DuelStatus @default(PENDING)
  // Set when status is ABANDONED: the guest who gave up (the other one wins).
  abandonedById    String?
  // Last time each player's duel screen polled: when both have been away
  // for DUEL_IDLE_MS the duel is deleted (see cleanupDuels in lib/duel.ts).
  challengerSeenAt DateTime?
  opponentSeenAt   DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  quiz       Quiz        @relation(fields: [quizId], references: [id], onDelete: Cascade)
  challenger GuestAccess @relation("DuelChallenger", fields: [challengerId], references: [id], onDelete: Cascade)
  opponent   GuestAccess @relation("DuelOpponent", fields: [opponentId], references: [id], onDelete: Cascade)
  rounds     DuelRound[]

  @@index([challengerId, status])
  @@index([opponentId, status])
}

// One round of a duel. Created with only chooserId set; the chooser then
// picks a chapter, which draws the round's questions and starts the clock
// (startedAt): each player then has DUEL_ROUND_SECONDS (lib/duel.ts) to answer. `questions` stores the
// public views (lib/question-resolver.ts getPublicView) so both players get
// exactly the same questions, including the same random CALCUL variables.
// The (duelId, index) unique constraint is what stops two simultaneous
// "last answer" requests from both creating the next round.
model DuelRound {
  id         String    @id @default(cuid())
  duelId     String
  index      Int
  chooserId  String
  themeId    String?
  themeTitle String?
  questions  Json?
  startedAt  DateTime?
  createdAt  DateTime  @default(now())

  duel    Duel         @relation(fields: [duelId], references: [id], onDelete: Cascade)
  answers DuelAnswer[]

  @@unique([duelId, index])
}

// Kept apart from Attempt on purpose: duel answers don't count towards a
// guest's progress, badges or leaderboard points.
model DuelAnswer {
  id            String   @id @default(cuid())
  roundId       String
  guestAccessId String
  questionId    String
  isCorrect     Boolean
  answerGiven   Json
  createdAt     DateTime @default(now())

  round       DuelRound   @relation(fields: [roundId], references: [id], onDelete: Cascade)
  guestAccess GuestAccess @relation(fields: [guestAccessId], references: [id], onDelete: Cascade)

  @@unique([roundId, guestAccessId, questionId])
}
